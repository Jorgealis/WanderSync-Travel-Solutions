# =============================================================================
# WanderSync — Variables de entorno
#
#   cp .env.example .env
#
# El archivo .env NUNCA se versiona (está en .gitignore).
# Todos los valores "change-me" deben reemplazarse por secretos aleatorios:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# --- General -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=wandersync
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
TZ=UTC

# --- PostgreSQL (superusuario: solo lo usan los scripts de init) ---------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wandersync
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Usuarios de BD por servicio (ver docs/contratos/modelo-datos.md) ---------
FLIGHTS_DB_USER=flights_svc
FLIGHTS_DB_PASSWORD=change-me
HOTELS_DB_USER=hotels_svc
HOTELS_DB_PASSWORD=change-me
CARS_DB_USER=cars_svc
CARS_DB_PASSWORD=change-me
ORDERS_DB_USER=orders_svc
ORDERS_DB_PASSWORD=change-me
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=change-me
INGEST_DB_USER=ingest
INGEST_DB_PASSWORD=change-me
HASURA_RO_DB_USER=hasura_ro
HASURA_RO_DB_PASSWORD=change-me

# Bases auxiliares en la misma instancia
HASURA_METADATA_DB=hasura_metadata
HASURA_METADATA_DB_USER=hasura_meta
HASURA_METADATA_DB_PASSWORD=change-me
PREFECT_DB=prefect
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=change-me

# --- Redis (sesiones + rate limiting) -----------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- Hasura -------------------------------------------------------------------
HASURA_GRAPHQL_ADMIN_SECRET=change-me
HASURA_GRAPHQL_ENABLE_CONSOLE=true # false en producción
HASURA_GRAPHQL_DEV_MODE=false
HASURA_URL=http://hasura:8080/v1/graphql
HASURA_GATEWAY_ROLE=gateway        # rol de solo lectura que usa el gateway

# --- Comunicación interna ------------------------------------------------------
INTERNAL_API_TOKEN=change-me
AUTH_SERVICE_URL=http://auth-service:8000
FLIGHTS_SERVICE_URL=http://flights-service:8000
HOTELS_SERVICE_URL=http://hotels-service:8000
CARS_SERVICE_URL=http://cars-service:8000
ORDERS_SERVICE_URL=http://orders-service:8000

# --- SAGA ----------------------------------------------------------------------
SAGA_STEP_TIMEOUT_SECONDS=3
SAGA_MAX_RETRIES=3
SAGA_RETRY_BACKOFF_SECONDS=0.5     # 0.5s, 1s, 2s...
SAGA_COMPENSATION_MAX_BACKOFF_SECONDS=30
SAGA_STEP_DELAY_SECONDS=1          # pausa artificial entre pasos para que la demo se vea en el frontend (0 = sin pausa)
ENABLE_FAULT_INJECTION=true        # false en producción
TAX_RATE=0.19

# --- Autenticación y sesiones --------------------------------------------------
SESSION_COOKIE_NAME=ws_session     # __Host-ws_session en producción
SESSION_COOKIE_SECURE=false        # true en producción (HTTPS)
SESSION_IDLE_TIMEOUT_SECONDS=1800  # 30 min sin actividad
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800  # 8 h máximo
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536       # 64 MiB
ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=10

# --- Rate limiting (sintaxis de la librería `limits`) --------------------------
RATE_LIMIT_LOGIN=5/minute          # por IP
RATE_LIMIT_REGISTER=3/minute       # por IP
RATE_LIMIT_BOOKING=3/minute        # por usuario (gateway)
RATE_LIMIT_PAYMENT=10/minute       # por usuario (orders-service, defensa en profundidad)
RATE_LIMIT_DEFAULT=120/minute      # resto de operaciones, por IP

# --- API Gateway ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_LIMIT=50
GRAPHQL_INTROSPECTION=true         # false en producción

# --- Frontend (se inyecta en build time) ----------------------------------------
VITE_GRAPHQL_URL=http://localhost:8000/graphql

# --- Dask ----------------------------------------------------------------------
DASK_SCHEDULER_ADDRESS=tcp://dask-scheduler:8786
DASK_WORKER_REPLICAS=3
DASK_WORKER_NTHREADS=2
DASK_WORKER_MEMORY_LIMIT=1GiB

# --- Prefect -------------------------------------------------------------------
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_UI_API_URL=http://localhost:4200/api
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://${PREFECT_DB_USER}:${PREFECT_DB_PASSWORD}@postgres:5432/${PREFECT_DB}

# --- Ingesta (flow de Prefect) -------------------------------------------------
INGEST_SCHEDULE_CRON="*/10 * * * *"
INGEST_ROUTES=BOG-MDE,BOG-CTG,BOG-SMR,MDE-CTG,MDE-BOG,CLO-CTG,BOG-ADZ
INGEST_DAYS_AHEAD=14
INGEST_STAY_NIGHTS=3,5,7           # duraciones de estadía/alquiler que se scrapean
INGEST_MAX_PAGES=5
INGEST_BATCH_SIZE=500
INGEST_TASK_RETRIES=3
INGEST_TASK_RETRY_DELAY_SECONDS=10

# --- Mock providers (fuentes de scraping simuladas) ----------------------------
MOCK_PROVIDERS_URL=http://mock-providers:8000
MOCK_SEED=42
MOCK_FAILURE_RATE=0.2              # probabilidad de responder 500/429/timeout
MOCK_LATENCY_MS_MIN=50
MOCK_LATENCY_MS_MAX=800
